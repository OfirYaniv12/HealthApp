{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ],
  "functions": {
    "api/gemini.js": {
      "maxDuration": 60
    },
    "api/steps.js": {
      "maxDuration": 15
    }
  }
}
